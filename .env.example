# Domain gốc. Đổi một dòng để đổi toàn bộ URL: s3.<BASE_DOMAIN>, files.<BASE_DOMAIN>
# localhost = chạy thử trên máy (Caddy tự cấp TLS nội bộ). Ví dụ thật: domain.dev
BASE_DOMAIN=localhost

# Sinh bằng: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
GARAGE_ADMIN_TOKEN=change-me

# Tên bucket được phục vụ công khai qua files.<BASE_DOMAIN>
PUBLIC_BUCKET=media
